# 应用配置
# 复制为 .env 并修改，或直接通过环境变量覆盖

# 本地代理（爬取PH用），不需要代理则设为空字符串
PROXY=http://127.0.0.1:7890

# 主下载目录；备用目录可填多个并用英文分号分隔。主目录低于保留空间时自动切换。
DOWNLOAD_DIR=downloads
DOWNLOAD_FALLBACK_DIRS=

# 头像本地资产目录、回填并发（1～32）与单张源图上限
AVATAR_DIR=data/avatars
AVATAR_FETCH_CONCURRENCY=3
AVATAR_MAX_BYTES=5242880

# 下载网络代理（仅用于 yt-dlp 下载；留空=直连，不会自动切换代理）
DOWNLOAD_PROXY=

# ffmpeg/ffprobe 所在目录（只做下载后的封装与校验，不参与网络下载）。
# 留空时依次查找：打包版 bin、项目 tools/ffmpeg、PATH；都找不到时新下载会暂缓而不是失败。
FFMPEG_DIR=

# 单一 HLS 下载引擎的连接与超时设置；WAITING 必须小于 STALL
DOWNLOAD_MAX_CONNECTIONS=15
DOWNLOAD_MAX_FRAGMENT_WORKERS_PER_TASK=12
DOWNLOAD_MIN_FREE_SPACE_GB=20
DOWNLOAD_SOCKET_TIMEOUT=10
DOWNLOAD_STALL_TIMEOUT=60
DOWNLOAD_WAITING_TIMEOUT=3
DOWNLOAD_FRAGMENT_RETRIES=5
DOWNLOAD_RESOLVE_TIMEOUT=90

# 并发/预算设置（不能设为 0）：媒体处理 1～8、普通同步 1～16、巡查 1～8、115读取 1～32
MAX_CONCURRENT_DOWNLOADS=5
MAX_CONCURRENT_UPLOADS=2
MEDIA_PROCESSING_CONCURRENCY=2
MODEL_SYNC_CONCURRENCY=4
PATROL_SYNC_CONCURRENCY=2
MAX_CONCURRENT_115_READS=6
MODEL_SYNC_TIMEOUT_SECONDS=180

# 115 VIDEO HUB 根目录 ID（必须填写自己的目录，禁止沿用他人的 CID）
VIDEO_HUB_CID=

# 时长模糊匹配容差（秒）
DURATION_TOLERANCE=3

# PH 站点
PH_BASE_URL=https://cn.pornhub.com

# 自动巡查更新：间隔需大于 0 且不超过 720 小时；页面修改后会持久化
PATROL_ENABLED=true            # 尚无运行时设置时，随项目启动自动开启
PATROL_INTERVAL_HOURS=6        # 尚无运行时设置时的巡查间隔（小时）
PATROL_AUTO_DOWNLOAD=true      # 发现缺失是否自动下载（关掉则只报数不下载）

# Bark 通知首次默认值；完整地址含 device_key，只能保存在本机 .env 或页面运行时设置中
NOTIFY_BARK_ENABLED=false
NOTIFY_BARK_URL=

# 有下载/上传在跑时阻止 Windows 自动睡眠（不强制亮屏），空闲后恢复系统原有策略
KEEP_AWAKE_WHILE_BUSY=true

# 下载近似总限速（MB/s，0=不限）与允许开始新下载的时段（HH:MM，都留空=全天，可跨午夜）。
# 这些与并发/连接数都可在下载页“下载设置”里修改，页面保存的值重启后优先。
DOWNLOAD_RATE_LIMIT_MBPS=0
DOWNLOAD_WINDOW_START=
DOWNLOAD_WINDOW_END=

# 外网登录成功后的会话时长（小时 1～720，记住天数 1～365）
REMOTE_SESSION_HOURS=12
REMOTE_REMEMBER_DAYS=30

# “探索”页本地视觉验证。ONNX 只在独立工作进程中使用，不上传图片。
TASTE_VISUAL_ENABLED=true
TASTE_VISUAL_MAX_THREADS=4
TASTE_VISUAL_BATCH_SIZE=12
TASTE_VISUAL_COVER_TIMEOUT=90
