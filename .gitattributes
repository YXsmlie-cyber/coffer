* text=auto

# 源码和配置在仓库中统一使用 LF
*.py text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.spec text eol=lf

# 仅由 Windows 直接执行的脚本保留 CRLF 工作区格式
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf
